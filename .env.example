# Copy to .env for local development. .env is git-ignored; never commit it.
# On Render these are set in the service dashboard, not in a file.

# Postgres. Locally: the value printed by `npx supabase status` (direct, port 54322).
# On Render: the Supabase SESSION pooler (port 5432) or the direct connection string.
# Never the transaction pooler (port 6543): the leader lock needs a real session, and
# config refuses that port at boot.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# verify-full (default) = TLS with certificate verification. disable is accepted only
# for a loopback host such as the local Supabase stack.
DATABASE_SSL=disable
# PEM of the database CA (Supabase dashboard → Database → SSL). Empty = system CAs.
DATABASE_SSL_CA=

# Third-party platform credentials. external.credential rows point at these names.
NEXD_API_KEY=
ZEUS_API_TOKEN=

# Bearer token required on /sync/* and /webhooks/* routes (phase 1 operator auth).
# At least 32 characters. Generate with: openssl rand -base64 32
SERVICE_ADMIN_TOKEN=

PORT=3000
LOG_LEVEL=info

# Reverse proxies in front of the service: 0 locally, 1 on Render, 2 with Cloudflare in front.
TRUST_PROXY_HOPS=0

# Schedules the 04:00 Europe/Zurich nightly pass in this process (default true). Every replica may;
# a Postgres leader lock picks one. Off here so `npm run dev` never calls the platforms at night.
SYNC_SCHEDULER_ENABLED=false

# Runs the minutely webhook tick in this process (default true). Every replica may; a Postgres
# leader lock picks one. Off here so local runs never POST to a client endpoint.
WEBHOOK_SCHEDULER_ENABLED=false

# Set by Render to the deployed commit; /healthz reports it so a deploy can tell its build is live.
# Leave empty locally.
RENDER_GIT_COMMIT=

# Always UTC. Source days and webhook schedules carry their own explicit timezones.
TZ=UTC
