# Copy to .env for local development. .env is git-ignored; never commit it.
# On Render these are set in the service dashboard, not in a file.

# Postgres. Locally: the value printed by `npx supabase status` (direct, port 54322).
# On Render: the Supabase SESSION pooler (port 5432) or the direct connection string.
# Never the transaction pooler (port 6543): the leader lock needs a real session, and
# config refuses that port at boot.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# verify-full (default) = TLS with certificate verification. disable is accepted only
# for a loopback host such as the local Supabase stack.
DATABASE_SSL=disable
# PEM of the database CA (Supabase dashboard → Database → SSL). Empty = system CAs.
DATABASE_SSL_CA=

# Third-party platform credentials. external.credential rows point at these names.
NEXD_API_KEY=
ZEUS_API_TOKEN=

# The NEXD folder that provisioning (POST /campaigns/:id/provision) creates campaigns and creatives
# in. Empty: the account root. On staging a test folder ("Petar - Test") until the flow is proven.
NEXD_PROVISION_FOLDER_ID=

# Bearer token required on /sync/* and /webhooks/* routes (phase 1 operator auth).
# At least 32 characters. Generate with: openssl rand -base64 32
SERVICE_ADMIN_TOKEN=

# Bearer token of POST /inbound/salesforce/opportunities, where Salesforce's webhook pushes committed
# opportunities. Its own token, different from SERVICE_ADMIN_TOKEN, at least 32 characters. Empty:
# the route does not exist.
INBOUND_CAMPAIGNS_TOKEN=

PORT=3000
LOG_LEVEL=info

# Reverse proxies in front of the service: 0 locally, 1 on Render, 2 with Cloudflare in front.
TRUST_PROXY_HOPS=0

# Schedules the 04:00 Europe/Zurich nightly pass in this process (default true). Every replica may;
# a Postgres leader lock picks one. Off here so `npm run dev` never calls the platforms at night.
SYNC_SCHEDULER_ENABLED=false

# Runs the minutely webhook tick in this process (default true). Every replica may; a Postgres
# leader lock picks one. Off here so local runs never POST to a client endpoint.
WEBHOOK_SCHEDULER_ENABLED=false

# Where this service is reachable from the internet, origin only. A csv webhook (Funnel) is sent a
# link to its file here, /exports/<id>.csv. Empty on Render: RENDER_EXTERNAL_URL is used. Empty
# locally: no csv webhook can be set up, since an importer could never reach this machine.
PUBLIC_BASE_URL=

# Set by Render to the deployed commit; /healthz reports it so a deploy can tell its build is live.
# Leave empty locally.
RENDER_GIT_COMMIT=

# Email (src/core/mail). Empty MAIL_PROVIDER = email is off and the next three are not read.
# resend sends through Resend; memory keeps messages in this process and sends nothing (local runs).
# Set, the service refuses to start without MAIL_FROM and the provider's key.
# Check the settings with: npm run mail -- test --to <your address>
MAIL_PROVIDER=
# Resend → API Keys: permission "Sending access", limited to the sender's domain. Starts with re_.
RESEND_API_KEY=
# "Name <address>" or "address", on a domain verified in Resend (region eu-west-1).
# Without a verified domain only Resend's test sender works: onboarding@resend.dev, which delivers
# to the Resend account's own address only.
MAIL_FROM=
# Optional: where replies go when MAIL_FROM is not a mailbox.
MAIL_REPLY_TO=

# Runs the minutely email report tick in this process (default true), only while email is on. Every
# replica may; a Postgres leader lock picks one. Off here so local runs never email anyone.
EMAIL_REPORT_SCHEDULER_ENABLED=false

# Always UTC. Source days and webhook schedules carry their own explicit timezones.
TZ=UTC
